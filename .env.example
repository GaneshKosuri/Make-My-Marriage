# ─────────────────────────────────────────────────────────────────────────────
# Make My Marriage — environment variables
#
# Copy to `.env.local` for local development:   cp .env.example .env.local
# Never commit real values. Validated once at runtime by src/server/config/env.ts.
# Integration keys are optional in development/test (console/fake adapters are
# used instead) but REQUIRED in production.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public origin. Used to build every emailed/shared link and to check
# the Origin header of mutations. The Host header is never trusted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB connection string. Development MUST use a separate database from
# production (a separate Atlas dev cluster, or a local replica set — transactions
# need a replica set). Outside production, database names that look like
# production (e.g. "...-prod", "production") are rejected.
MONGODB_URI=mongodb://127.0.0.1:27017/make-my-marriage-dev?replicaSet=rs0

# At least 32 random bytes. HMAC key for sessions, password-reset tokens,
# member-invitation tokens and rate-limit keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session lifetime in days (default 30).
SESSION_TTL_DAYS=30

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to
# /api/internal/jobs/email. Optional locally (the route then rejects all calls);
# required in production. Use at least 32 random characters.
CRON_SECRET=

# Email. Without a key, development prints emails to the console.
# Resend needs a verified domain: onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM="Make My Marriage <noreply@example.com>"
# Or send from a personal Gmail (no domain needed, about 500 recipients a day). Turn on 2-Step
# Verification, create an app password at myaccount.google.com/apppasswords, and set both.
# With Gmail the From address becomes GMAIL_USER (EMAIL_FROM's display name is kept).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Which sender to use: gmail, resend or console. Leave empty to pick the first one configured
# (Gmail, then Resend, then console). Restart `next dev` after changing it.
EMAIL_PROVIDER=
# Bulk-email jobs processed per cron run (docs: 25–50).
EMAIL_BATCH_SIZE=25

# Cloudflare R2 (S3-compatible) — private bucket, bucket-scoped credentials.
# Development and production use separate buckets/credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google Places API (vendor discovery). Server-side only.
GOOGLE_PLACES_API_KEY=
